# Purpose-built Fedora/Linux verification image. Contains TEST TOOLS ONLY.
# Image build downloads Fedora RPMs ONCE. Test runtime has no network.
# Do not COPY project sources: runtime mounts a disposable checkout read-only.
FROM fedora:43

RUN dnf -y --setopt=install_weak_deps=False install \
        bash \
        git \
        python3 \
        python3-pyside6 \
        qt6-qtbase-gui \
        libvirt-client \
        qemu-img \
        libxml2 \
    && dnf clean all \
    && command -v virt-xml-validate \
    && command -v qemu-img \
    && python3 -c "import PySide6.QtWidgets; print('Fedora PySide6 ready')" \
    && python3 --version

# Unprivileged UID; Docker run also uses --cap-drop ALL and --network none.
USER 10001:10001
WORKDIR /workspace
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONNOUSERSITE=1 \
    QT_QPA_PLATFORM=offscreen \
    MIDNIGHT_PROVISIONER_GUI_SMOKE=0 \
    HOME=/tmp \
    XDG_CONFIG_HOME=/tmp/midnight-provisioner-config \
    XDG_DATA_HOME=/tmp/midnight-provisioner-data \
    MIDNIGHT_PROVISIONER_GUI_PREVIEW=/tmp/midnight-provisioner-gui-smoke.png

# Only source syntax, synthetic unit tests, offscreen Qt and benign fixture
# QEMU/libvirt tools. NEVER run a VM, daemon, guest agent, privileged mount,
# installer, network scanner or production Midnight Provisioner CLI lifecycle command.
ENTRYPOINT ["python3", "-B", "scripts/testing/verify_local.py"]
CMD ["--all"]
