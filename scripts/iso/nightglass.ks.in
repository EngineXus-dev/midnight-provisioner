# Nightglass installer kickstart (partial) - rendered by scripts/iso/render_kickstart.py
# Source commit: @COMMIT@
#
# Storage is deliberately NOT configured here. In the installer you choose the
# disk yourself on "Installation Destination" and tick "Encrypt my data".
# Nothing is selected or erased automatically. Language, keyboard, time zone
# and your user account are also set on the installer screens.

graphical

# Official Fedora mirrors (network install). $releasever matches the ISO.
url --mirrorlist="https://mirrors.fedoraproject.org/mirrorlist?repo=fedora-$releasever&arch=$basearch"
repo --name=updates --mirrorlist="https://mirrors.fedoraproject.org/mirrorlist?repo=updates-released-f$releasever&arch=$basearch"

selinux --enforcing
firewall --enabled

%packages
@^kde-desktop-environment
qemu-kvm
libvirt
edk2-ovmf
virt-install
virt-manager
virt-viewer
virtiofsd
podman
distrobox
python3
python3-pyside6
cryptsetup
mokutil
%end

%post --erroronfail --log=/root/nightglass-install.log
set -eu
umask 022
payload="$(mktemp)"
base64 -d > "$payload" <<'NIGHTGLASS_PAYLOAD'
@PAYLOAD@
NIGHTGLASS_PAYLOAD
# Refuse to install anything that does not match the archive built into this ISO.
echo "@SHA256@  $payload" | sha256sum -c -
rm -rf /opt/nightglass
install -d -m 0755 /opt/nightglass
tar -xzf "$payload" -C /opt/nightglass --no-same-owner --no-same-permissions
rm -f "$payload"
chown -R root:root /opt/nightglass
chmod -R u+rwX,go+rX,go-w /opt/nightglass
echo "@COMMIT@" > /opt/nightglass/INSTALLED-COMMIT
python3 -m compileall -q /opt/nightglass/nightglass || echo "Nightglass: bytecode precompile skipped"

cat > /usr/local/bin/nightglass <<'EOF'
#!/bin/sh
# Installed by the Nightglass installer ISO; read-only copy in /opt/nightglass.
PYTHONPATH="/opt/nightglass${PYTHONPATH:+:$PYTHONPATH}" exec /usr/bin/python3 -m nightglass "$@"
EOF
chmod 0755 /usr/local/bin/nightglass

cat > /usr/share/applications/nightglass.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=Nightglass Workspaces
Comment=Qubes-inspired security workspace controller
Exec=/usr/local/bin/nightglass gui
Icon=security-high
Terminal=false
Categories=System;Security;
EOF

# libvirt's per-driver daemons; VMs and the lab network are NOT created here.
for unit in virtqemud.socket virtnetworkd.socket virtstoraged.socket virtnodedevd.socket virtsecretd.socket; do
    systemctl enable "$unit" || echo "Nightglass: could not enable $unit"
done
echo "Nightglass installed to /opt/nightglass from commit @COMMIT@"
%end
