# Midnight Provisioner installer kickstart (partial) - rendered by scripts/iso/Fedora/render_kickstart.py
# Source commit: @COMMIT@
#
# Storage is deliberately NOT configured here. In the installer you choose the
# disk yourself on "Installation Destination" and tick "Encrypt my data".
# Nothing is selected or erased automatically. Language, keyboard, time zone
# and your user account are also set on the installer screens.

graphical

# Official Fedora mirrors (network install). $releasever matches the ISO.
url --mirrorlist="https://mirrors.fedoraproject.org/mirrorlist?repo=fedora-$releasever&arch=$basearch"
repo --name=updates --mirrorlist="https://mirrors.fedoraproject.org/mirrorlist?repo=updates-released-f$releasever&arch=$basearch"

selinux --enforcing
firewall --enabled

%packages
@^kde-desktop-environment
qemu-kvm
libvirt
edk2-ovmf
virt-install
virt-manager
virt-viewer
virtiofsd
podman
distrobox
python3
python3-pyside6
cryptsetup
mokutil
%end

%post --erroronfail --log=/root/midnight-provisioner-install.log
set -eu
umask 022
payload="$(mktemp)"
base64 -d > "$payload" <<'MIDNIGHT_PROVISIONER_PAYLOAD'
@PAYLOAD@
MIDNIGHT_PROVISIONER_PAYLOAD
# Refuse to install anything that does not match the archive built into this ISO.
echo "@SHA256@  $payload" | sha256sum -c -
rm -rf /opt/midnight-provisioner
install -d -m 0755 /opt/midnight-provisioner
tar -xzf "$payload" -C /opt/midnight-provisioner --no-same-owner --no-same-permissions
rm -f "$payload"
chown -R root:root /opt/midnight-provisioner
chmod -R u+rwX,go+rX,go-w /opt/midnight-provisioner
echo "@COMMIT@" > /opt/midnight-provisioner/INSTALLED-COMMIT
python3 -m compileall -q /opt/midnight-provisioner/midnight_provisioner || echo "Midnight Provisioner: bytecode precompile skipped"

cat > /usr/local/bin/midnight-provisioner <<'EOF'
#!/bin/sh
# Installed by the Midnight Provisioner installer ISO; read-only copy in /opt/midnight-provisioner.
PYTHONPATH="/opt/midnight-provisioner${PYTHONPATH:+:$PYTHONPATH}" exec /usr/bin/python3 -m midnight_provisioner "$@"
EOF
chmod 0755 /usr/local/bin/midnight-provisioner

cat > /usr/share/applications/midnight-provisioner.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=Midnight Provisioner Workspaces
Comment=Qubes-inspired security workspace controller
Exec=/usr/local/bin/midnight-provisioner gui
Icon=security-high
Terminal=false
Categories=System;Security;
EOF

# libvirt's per-driver daemons; VMs and the lab network are NOT created here.
for unit in virtqemud.socket virtnetworkd.socket virtstoraged.socket virtnodedevd.socket virtsecretd.socket; do
    systemctl enable "$unit" || echo "Midnight Provisioner: could not enable $unit"
done

# Passwordless libvirt Polkit rule for wheel and libvirt group members
groupadd -f libvirt || true
cat > /etc/polkit-1/rules.d/49-midnight-libvirt.rules <<'EOF'
/* Allow desktop users in wheel or libvirt group to monitor and manage qemu:///system without password popups */
polkit.addRule(function(action, subject) {
    if ((action.id === "org.libvirt.unix.monitor" || action.id === "org.libvirt.unix.manage") &&
        (subject.isInGroup("wheel") || subject.isInGroup("libvirt"))) {
        return polkit.Result.YES;
    }
});
EOF
chmod 0644 /etc/polkit-1/rules.d/49-midnight-libvirt.rules

# Keep the NVMe workaround on installed kernels too. This runs after formatting;
# build-midnight-provisioner-iso.sh separately sets the installer's boot arguments.
# APST is disabled; pcie_aspm=off leaves firmware ASPM settings unchanged.
if command -v grubby >/dev/null 2>&1; then
    grubby --update-kernel=ALL --args="nvme_core.default_ps_max_latency_us=0 pcie_aspm=off" || true
fi

echo "Midnight Provisioner installed to /opt/midnight-provisioner from commit @COMMIT@"
%end
